      "source": [
        "board = [\n",
        "    'X', 'O', 'X',\n",
        "    'O', 'X', 'O',\n",
        "    'O', 'X', 'X'\n",
        "]\n",
        "\n",
        "def show_board():\n",
        "    for i in range(0, 9, 3):\n",
        "        print(' | '.join(board[i:i+3]))\n",
        "        if i < 6:\n",
        "            print('--+---+--')\n",
        "\n",
        "show_board()\n",
        "print(\"Winner: X\")"
